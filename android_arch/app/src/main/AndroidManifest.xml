<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 权限声明 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ TTS 引擎服务可见性声明 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".FutureKoreanApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FutureKorean"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <!-- 全安卓厂商（小米/荣耀/华为/OPPO/vivo/三星）极速 120Hz/144Hz 满血高刷与硬件加速白名单声明 -->
        <meta-data android:name="android.max_aspect" android:value="2.6" />
        <meta-data android:name="notch.config" android:value="portrait|landscape" />
        <meta-data android:name="android.notch_support" android:value="true" />
        <!-- 荣耀 MagicOS / 华为 HarmonyOS/EMUI -->
        <meta-data android:name="hihonor.display.high_refresh_rate" android:value="true" />
        <meta-data android:name="huawei.display.high_refresh_rate" android:value="true" />
        <meta-data android:name="com.hihonor.android.os.display.force_120hz" android:value="true" />
        <!-- 小米澎湃 OS / MIUI (HyperOS) -->
        <meta-data android:name="miui.display.high_refresh_rate" android:value="true" />
        <meta-data android:name="xiaomi.display.high_refresh_rate" android:value="true" />
        <meta-data android:name="miui.performance.mode" android:value="true" />
        <!-- OPPO / 一加 / 真我 (ColorOS / OxygenOS / RealmeUI) -->
        <meta-data android:name="oppo.display.high_refresh_rate" android:value="true" />
        <meta-data android:name="oplus.display.high_refresh_rate" android:value="true" />
        <meta-data android:name="oneplus.display.high_refresh_rate" android:value="true" />
        <!-- vivo / iQOO (OriginOS) -->
        <meta-data android:name="vivo.display.high_refresh_rate" android:value="true" />
        <meta-data android:name="vivo_game_support" android:value="true" />
        <!-- 通用 Android Vendor -->
        <meta-data android:name="android.vendor.display.high_refresh_rate" android:value="true" />

        <!-- 主 Activity：单 Activity Compose 架构 + Edge-to-Edge -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FutureKorean"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 独立进程崩溃诊断 Activity（保证主进程任何异常均能被可视化捕获并展示） -->
        <activity
            android:name=".CrashDisplayActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- 桌面小组件 (Jetpack Glance Widget Receiver) -->
        <receiver
            android:name="com.yonsei.koreanlearner.glance.DailyWordGlanceWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_daily_word_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_word_widget_info" />
        </receiver>

        <!-- 经典桌面小组件 (Classic RemoteViews Widget Provider) -->
        <receiver
            android:name="com.futurekorean.app.widget.DailyWordWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily_word_info" />
        </receiver>

        <!-- 4x2 延世 7 轮复习进度桌面小组件 -->
        <receiver
            android:name="com.futurekorean.app.widget.ReviewProgressWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_review_progress_info" />
        </receiver>

        <!-- 后台 TTS 发音服务 -->
        <service
            android:name="com.yonsei.koreanlearner.glance.GlanceTtsService"
            android:exported="false" />

    </application>

</manifest>
